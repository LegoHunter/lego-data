CREATE TABLE IF NOT EXISTS photo_upload_token (
    photo_upload_token_id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    environment VARCHAR(16) NOT NULL,
    token_name VARCHAR(100) NOT NULL,
    token_kind VARCHAR(16) NOT NULL,
    token_hmac CHAR(64) NOT NULL UNIQUE,
    family_id CHAR(36) NOT NULL,
    expires_at TIMESTAMP(3) NOT NULL,
    retired_at TIMESTAMP(3),
    revoked_at TIMESTAMP(3),
    created_at TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3)
);
CREATE INDEX IF NOT EXISTS ix_photo_upload_token_family ON photo_upload_token (family_id);
