CREATE TABLE IF NOT EXISTS photo_upload_batch (
    batch_id CHAR(36) PRIMARY KEY,
    environment VARCHAR(16) NOT NULL,
    token_name VARCHAR(100) NOT NULL,
    created_at TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3)
);
CREATE TABLE IF NOT EXISTS photo_upload_batch_file (
    photo_upload_batch_file_id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    batch_id CHAR(36) NOT NULL REFERENCES photo_upload_batch (batch_id),
    file_name VARCHAR(255) NOT NULL,
    state VARCHAR(16) NOT NULL,
    reason VARCHAR(500),
    item_inventory_photo_id INTEGER,
    md5 CHAR(32),
    created_at TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
    updated_at TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
    CONSTRAINT uq_photo_upload_batch_file UNIQUE (batch_id, file_name)
);
